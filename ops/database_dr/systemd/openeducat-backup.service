[Unit]
Description=OpenEduCat PostgreSQL and filestore backup
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=oneshot
User=odoo
Group=odoo
EnvironmentFile=/etc/openeducat/backup.env
WorkingDirectory=/opt/odoo/custom-addons/openeducat_erp
ExecStart=/opt/odoo/custom-addons/openeducat_erp/ops/database_dr/bin/backup_openeducat.sh
Nice=10

[Install]
WantedBy=multi-user.target
