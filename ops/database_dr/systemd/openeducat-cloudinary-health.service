[Unit]
Description=OpenEduCat Cloudinary health check
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=odoo
Group=odoo
EnvironmentFile=/etc/openeducat/backup.env
WorkingDirectory=/opt/odoo/custom-addons/openeducat_erp
ExecStart=/opt/odoo/custom-addons/openeducat_erp/ops/database_dr/bin/check_cloudinary_health.sh
