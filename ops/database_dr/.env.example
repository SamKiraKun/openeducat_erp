# Source Odoo/PostgreSQL settings
ODOO_CONF=/etc/odoo/odoo.conf
ODOO_DATA_DIR=/var/lib/odoo
ODOO_DATABASES="openeducat_prod"
ODOO_BIN=odoo-bin
REPO_ROOT=/opt/odoo/custom-addons/openeducat_erp
INCLUDE_REPO_ARCHIVE=1
REPO_ARCHIVE_NAME=openeducat_erp_repo.tar.gz

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=odoo
PGPASSWORD=CHANGE_ME

# Backup settings
BACKUP_ROOT=/var/backups/openeducat
BACKUP_SET_RETENTION=14
BACKUP_MAX_AGE_HOURS=26
RESTORE_DRILL_MAX_AGE_DAYS=35
DISK_WARN_PERCENT=80
DISK_CRIT_PERCENT=90

# Restore target settings. Point these at Aiven for Stage 1 Pattern B, or at a
# disposable PostgreSQL instance for restore drills.
RESTORE_PGHOST=CHANGE_ME
RESTORE_PGPORT=5432
RESTORE_PGUSER=CHANGE_ME
RESTORE_PGPASSWORD=CHANGE_ME
RESTORE_PGSSLMODE=require
RESTORE_ADMIN_DB=postgres
RESTORE_TARGET_DB_PREFIX=dr_
RESTORE_TARGET_DB_SUFFIX=

# Optional. When set, restore_backup_set.sh extracts the matching filestore
# archive into this directory for end-to-end Odoo recovery drills.
RESTORE_FILESTORE_ROOT=/srv/openeducat-dr/filestore

# Stage 2 logical replication settings. PRIMARY_ADMIN_* should be a role with
# enough rights to inspect PostgreSQL settings and create the replication role
# plus publications. PRIMARY_PUBLIC_HOST must be the source host that Aiven can
# reach.
PRIMARY_ADMIN_PGHOST=127.0.0.1
PRIMARY_ADMIN_PGPORT=5432
PRIMARY_ADMIN_PGUSER=postgres
PRIMARY_ADMIN_PGPASSWORD=CHANGE_ME
PRIMARY_ADMIN_PGSSLMODE=prefer
PRIMARY_ADMIN_DB=postgres
PRIMARY_DB_OWNER=odoo
PRIMARY_PUBLIC_HOST=CHANGE_ME
PRIMARY_PUBLIC_PORT=5432
PRIMARY_REPLICATION_SSLMODE=require

# Stage 2 subscriber settings. If left empty, the replication scripts fall back
# to the RESTORE_* target connection values above.
SUBSCRIBER_ADMIN_PGHOST=
SUBSCRIBER_ADMIN_PGPORT=
SUBSCRIBER_ADMIN_PGUSER=
SUBSCRIBER_ADMIN_PGPASSWORD=
SUBSCRIBER_ADMIN_PGSSLMODE=require
SUBSCRIBER_ADMIN_DB=postgres
SUBSCRIBER_DB_PREFIX=dr_
SUBSCRIBER_DB_SUFFIX=

REPLICATION_USER=aiven_repl
REPLICATION_PASSWORD=CHANGE_ME
PUBLICATION_PREFIX=openeducat_pub_
SUBSCRIPTION_PREFIX=openeducat_sub_
REPLICATION_SLOT_PREFIX=openeducat_slot_

REPLICATION_LAG_WARN_SECONDS=300
REPLICATION_LAG_CRIT_SECONDS=1800
REPLICATION_SLOT_LAG_WARN_BYTES=1073741824
REPLICATION_SLOT_LAG_CRIT_BYTES=5368709120

# Cloudinary runtime media settings. Keep these aligned with the Odoo addon
# configuration in Settings once Cloudinary storage is enabled.
CLOUDINARY_ENABLED=0
CLOUDINARY_CLOUD_NAME=CHANGE_ME
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
CLOUDINARY_FOLDER_PREFIX=openeducat
CLOUDINARY_ENVIRONMENT=prod
CLOUDINARY_SCHOOL_CODE=CHANGE_ME
CLOUDINARY_DELIVERY_MODE=authenticated
CLOUDINARY_MAX_UPLOAD_MB=8
CLOUDINARY_DELETE_REMOTE_ON_UNLINK=1
CLOUDINARY_DELETE_RETENTION_DAYS=15
