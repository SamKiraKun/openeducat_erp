<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_cloudinary_retry_failed_uploads" model="ir.cron">
        <field name="name">Cloudinary: Retry Failed Attachment Uploads</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">model._cron_cloudinary_retry_failed_uploads()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">10</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_cloudinary_verify_recent_uploads" model="ir.cron">
        <field name="name">Cloudinary: Verify Recent Attachment Uploads</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">model._cron_cloudinary_verify_recent_uploads()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>

    <record id="ir_cron_cloudinary_cleanup_due_assets" model="ir.cron">
        <field name="name">Cloudinary: Cleanup Retained Remote Assets</field>
        <field name="model_id" ref="base.model_ir_attachment"/>
        <field name="state">code</field>
        <field name="code">model._cron_cloudinary_cleanup_due_assets()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">12</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="False"/>
    </record>
</odoo>
